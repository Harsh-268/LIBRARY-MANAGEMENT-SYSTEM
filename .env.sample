# =============================================================================
# BookStore (LMS) - Server environment variables
# -----------------------------------------------------------------------------
# 1. Copy this file to `.env` inside the `server/` folder:  cp .env.sample .env
# 2. Fill in every value below.
# 3. NEVER commit your real `.env` file (it is already in .gitignore).
# =============================================================================


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Port the Express server listens on. The client's axios instance points to
# http://localhost:5001/api/v1 by default, so keep 5001 unless you also set
# VITE_APP_BASE_URL in the client.
PORT=5001

# URL of the React (Vite) frontend. Used for CORS, so the browser is allowed to
# send cookies to the API. Must match the exact origin (no trailing slash).
# Dev: http://localhost:5173  |  Prod: https://your-frontend-domain.com
CORS_ORIGIN=http://localhost:5173

# Base URL of the frontend, used to build the password-reset link sent by email
# (e.g. <CLIENT_URL>/reset-password/<token>). Usually the same as CORS_ORIGIN.
CLIENT_URL=http://localhost:5173


# -----------------------------------------------------------------------------
# Database (MongoDB)
# -----------------------------------------------------------------------------
# MongoDB connection string WITHOUT a database name and WITHOUT a trailing
# slash. The app appends the database name ("lms") automatically.
#   Local:  mongodb://127.0.0.1:27017
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net
# NOTE: Issuing/returning books and stock updates use MongoDB transactions,
# which require a replica set. MongoDB Atlas works out of the box; for a local
# install, run mongod as a single-node replica set.
MONGODB_URI=


# -----------------------------------------------------------------------------
# Authentication (JWT)
# -----------------------------------------------------------------------------
# Secret used to sign short-lived ACCESS tokens. Use a long random string.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=

# How long an access token stays valid (jsonwebtoken format: 15m, 1h, 1d ...).
ACCESS_TOKEN_EXPIRY=15m

# Secret used to sign long-lived REFRESH tokens. Must be DIFFERENT from
# ACCESS_TOKEN_SECRET. Generate it the same way as above.
REFRESH_TOKEN_SECRET=

# How long a refresh token stays valid (e.g. 7d, 10d).
REFRESH_TOKEN_EXPIRY=7d


# -----------------------------------------------------------------------------
# Google Books API
# -----------------------------------------------------------------------------
# API key used by the admin "Add Book" ISBN lookup.
# Create one at https://console.cloud.google.com/ -> APIs & Services ->
# enable "Books API" -> Credentials -> Create API key.
GOOGLE_BOOKS_API_KEY=


# -----------------------------------------------------------------------------
# Email (SMTP via Nodemailer)
# -----------------------------------------------------------------------------
# Used for the contact form and password-reset emails.
# Gmail example: host smtp.gmail.com, port 587, and an App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords).

# SMTP server hostname (e.g. smtp.gmail.com, smtp.sendgrid.net).
SMTP_HOST=

# SMTP port. 587 (STARTTLS) is the common default; use 465 for SSL/TLS.
SMTP_PORT=587

# SMTP login username (usually the full email address).
SMTP_USER=

# SMTP password or app-specific password. Do not use your normal account
# password if your provider supports app passwords.
SMTP_PASS=

# "From" address shown on outgoing emails. Falls back to SMTP_USER if empty.
SMTP_FROM=

# Inbox that receives messages submitted through the Contact Us form.
CONTACT_RECEIVER_EMAIL=
